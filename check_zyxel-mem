#!/bin/bash
# Nagios plugin to check memory usage of a Zyxel switch via SNMP.

STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

OID=".1.3.6.1.4.1.890.1.15.3.2.5.0"
WARN_LVL="80"
CRIT_LVL="90"
HOSTADDRESS=""
COMMUNITY="public"
SNMP_VERSION="2c"
SNMP_PORT="161"
SNMP_TIMEOUT="2"
SNMP_RETRIES="1"
V3_USER=""
V3_LEVEL=""
V3_AUTH_PROTO="SHA"
V3_AUTH_PASS=""
V3_PRIV_PROTO="AES"
V3_PRIV_PASS=""

usage() {
   cat <<EOF
Usage: $0 -H <host> [-w <warn>] [-c <crit>] [-C <community>] [-V 2c|3] [-p <port>]
        [-u <v3_user>] [-l noAuthNoPriv|authNoPriv|authPriv] [-a MD5|SHA] [-A <auth_pass>]
      [-x DES|AES] [-X <priv_pass>] [-t <timeout>] [-r <retries>]
EOF
}

is_int() {
   [[ "$1" =~ ^[0-9]+$ ]]
}

while getopts "hH:w:c:C:V:p:u:l:a:A:x:X:t:r:" OPTION; do
   case "$OPTION" in
      h) usage; exit "$STATE_UNKNOWN" ;;
      H) HOSTADDRESS="$OPTARG" ;;
      w) WARN_LVL="$OPTARG" ;;
      c) CRIT_LVL="$OPTARG" ;;
      C) COMMUNITY="$OPTARG" ;;
      V) SNMP_VERSION="$OPTARG" ;;
      p) SNMP_PORT="$OPTARG" ;;
      u) V3_USER="$OPTARG" ;;
      l) V3_LEVEL="$OPTARG" ;;
      a) V3_AUTH_PROTO="$OPTARG" ;;
      A) V3_AUTH_PASS="$OPTARG" ;;
      x) V3_PRIV_PROTO="$OPTARG" ;;
      X) V3_PRIV_PASS="$OPTARG" ;;
      t) SNMP_TIMEOUT="$OPTARG" ;;
      r) SNMP_RETRIES="$OPTARG" ;;
      *) usage; exit "$STATE_UNKNOWN" ;;
   esac
done

if [[ -z "$HOSTADDRESS" ]]; then
   echo "UNKNOWN - missing host (-H)"
   exit "$STATE_UNKNOWN"
fi

if ! is_int "$WARN_LVL" || ! is_int "$CRIT_LVL"; then
   echo "UNKNOWN - thresholds must be integers"
   exit "$STATE_UNKNOWN"
fi

if (( WARN_LVL >= CRIT_LVL )); then
   echo "UNKNOWN - warning must be lower than critical"
   exit "$STATE_UNKNOWN"
fi

if ! command -v snmpget >/dev/null 2>&1; then
   echo "UNKNOWN - snmpget not found"
   exit "$STATE_UNKNOWN"
fi

SNMP_ARGS=(-Oqv -t "$SNMP_TIMEOUT" -r "$SNMP_RETRIES" "$HOSTADDRESS:$SNMP_PORT")

if [[ "$SNMP_VERSION" == "3" ]]; then
   if [[ -z "$V3_USER" || -z "$V3_LEVEL" ]]; then
      echo "UNKNOWN - SNMPv3 requires -u <user> and -l <security level>"
      exit "$STATE_UNKNOWN"
   fi
   SNMP_ARGS=(-v3 -u "$V3_USER" -l "$V3_LEVEL" -Oqv -t "$SNMP_TIMEOUT" -r "$SNMP_RETRIES" "$HOSTADDRESS:$SNMP_PORT")
   if [[ "$V3_LEVEL" == "authNoPriv" || "$V3_LEVEL" == "authPriv" ]]; then
      SNMP_ARGS+=(-a "$V3_AUTH_PROTO" -A "$V3_AUTH_PASS")
   fi
   if [[ "$V3_LEVEL" == "authPriv" ]]; then
      SNMP_ARGS+=(-x "$V3_PRIV_PROTO" -X "$V3_PRIV_PASS")
   fi
else
   SNMP_ARGS=(-v2c -c "$COMMUNITY" -Oqv -t "$SNMP_TIMEOUT" -r "$SNMP_RETRIES" "$HOSTADDRESS:$SNMP_PORT")
fi

MEM_USAGE="$(snmpget "${SNMP_ARGS[@]}" "$OID" 2>/dev/null)"
MEM_USAGE="${MEM_USAGE//\"/}"

if ! is_int "$MEM_USAGE"; then
   echo "UNKNOWN - unable to read memory usage via SNMP"
   exit "$STATE_UNKNOWN"
fi

if (( MEM_USAGE >= CRIT_LVL )); then
   echo "CRITICAL - memory usage ${MEM_USAGE}% | mem=${MEM_USAGE}%;${WARN_LVL};${CRIT_LVL};0;100"
   exit "$STATE_CRITICAL"
fi

if (( MEM_USAGE >= WARN_LVL )); then
   echo "WARNING - memory usage ${MEM_USAGE}% | mem=${MEM_USAGE}%;${WARN_LVL};${CRIT_LVL};0;100"
   exit "$STATE_WARNING"
fi

echo "OK - memory usage ${MEM_USAGE}% | mem=${MEM_USAGE}%;${WARN_LVL};${CRIT_LVL};0;100"
exit "$STATE_OK"
