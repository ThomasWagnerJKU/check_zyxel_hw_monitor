#!/bin/bash
# Nagios plugin to check fan RPM of a Zyxel switch via SNMP.

STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

HOSTADDRESS=""
COMMUNITY="public"
SNMP_VERSION="2c"
SNMP_PORT="161"
SNMP_TIMEOUT="2"
SNMP_RETRIES="1"
SENSOR_INDEX="1"
WARN_LVL=""
CRIT_LVL=""
V3_USER=""
V3_LEVEL=""
V3_AUTH_PROTO="SHA"
V3_AUTH_PASS=""
V3_PRIV_PROTO="AES"
V3_PRIV_PASS=""

usage() {
   cat <<EOF
Usage: $0 -H <host> [-i <sensor_index>] [-w <warn_rpm>] [-c <crit_rpm>] [-C <community>] [-V 2c|3]
        [-u <v3_user>] [-l noAuthNoPriv|authNoPriv|authPriv] [-a MD5|SHA] [-A <auth_pass>]
          [-x DES|AES] [-X <priv_pass>] [-p <port>] [-t <timeout>] [-r <retries>]
EOF
}

is_int() {
   [[ "$1" =~ ^[0-9]+$ ]]
}

snmp_get() {
   snmpget "${SNMP_ARGS[@]}" "$1" 2>/dev/null | tr -d '"'
}

while getopts "hH:i:w:c:C:V:p:u:l:a:A:x:X:t:r:" OPTION; do
   case "$OPTION" in
      h) usage; exit "$STATE_UNKNOWN" ;;
      H) HOSTADDRESS="$OPTARG" ;;
      i) SENSOR_INDEX="$OPTARG" ;;
      w) WARN_LVL="$OPTARG" ;;
      c) CRIT_LVL="$OPTARG" ;;
      C) COMMUNITY="$OPTARG" ;;
      V) SNMP_VERSION="$OPTARG" ;;
      p) SNMP_PORT="$OPTARG" ;;
      u) V3_USER="$OPTARG" ;;
      l) V3_LEVEL="$OPTARG" ;;
      a) V3_AUTH_PROTO="$OPTARG" ;;
      A) V3_AUTH_PASS="$OPTARG" ;;
      x) V3_PRIV_PROTO="$OPTARG" ;;
      X) V3_PRIV_PASS="$OPTARG" ;;
      t) SNMP_TIMEOUT="$OPTARG" ;;
      r) SNMP_RETRIES="$OPTARG" ;;
      *) usage; exit "$STATE_UNKNOWN" ;;
   esac
done

if [[ -z "$HOSTADDRESS" ]]; then
   echo "UNKNOWN - missing host (-H)"
   exit "$STATE_UNKNOWN"
fi

if ! is_int "$SENSOR_INDEX"; then
   echo "UNKNOWN - sensor index must be an integer"
   exit "$STATE_UNKNOWN"
fi

if [[ -n "$WARN_LVL" && ! "$WARN_LVL" =~ ^[0-9]+$ ]]; then
   echo "UNKNOWN - warning threshold must be an integer"
   exit "$STATE_UNKNOWN"
fi

if [[ -n "$CRIT_LVL" && ! "$CRIT_LVL" =~ ^[0-9]+$ ]]; then
   echo "UNKNOWN - critical threshold must be an integer"
   exit "$STATE_UNKNOWN"
fi

if [[ -n "$WARN_LVL" && -n "$CRIT_LVL" ]] && (( WARN_LVL <= CRIT_LVL )); then
   echo "UNKNOWN - for fan RPM, warning must be higher than critical"
   exit "$STATE_UNKNOWN"
fi

if ! command -v snmpget >/dev/null 2>&1; then
   echo "UNKNOWN - snmpget not found"
   exit "$STATE_UNKNOWN"
fi

if [[ "$SNMP_VERSION" == "3" ]]; then
   if [[ -z "$V3_USER" || -z "$V3_LEVEL" ]]; then
      echo "UNKNOWN - SNMPv3 requires -u <user> and -l <security level>"
      exit "$STATE_UNKNOWN"
   fi
   SNMP_ARGS=(-v3 -u "$V3_USER" -l "$V3_LEVEL" -Oqv -t "$SNMP_TIMEOUT" -r "$SNMP_RETRIES" "$HOSTADDRESS:$SNMP_PORT")
   if [[ "$V3_LEVEL" == "authNoPriv" || "$V3_LEVEL" == "authPriv" ]]; then
      SNMP_ARGS+=(-a "$V3_AUTH_PROTO" -A "$V3_AUTH_PASS")
   fi
   if [[ "$V3_LEVEL" == "authPriv" ]]; then
      SNMP_ARGS+=(-x "$V3_PRIV_PROTO" -X "$V3_PRIV_PASS")
   fi
else
   SNMP_ARGS=(-v2c -c "$COMMUNITY" -Oqv -t "$SNMP_TIMEOUT" -r "$SNMP_RETRIES" "$HOSTADDRESS:$SNMP_PORT")
fi

DESC="$(snmp_get ".1.3.6.1.4.1.890.1.15.3.26.1.1.1.2.${SENSOR_INDEX}")"
RPM="$(snmp_get ".1.3.6.1.4.1.890.1.15.3.26.1.1.1.3.${SENSOR_INDEX}")"
MAX_RPM="$(snmp_get ".1.3.6.1.4.1.890.1.15.3.26.1.1.1.4.${SENSOR_INDEX}")"
STATUS="$(snmp_get ".1.3.6.1.4.1.890.1.15.3.26.1.1.1.7.${SENSOR_INDEX}")"

if ! is_int "$RPM"; then
   echo "UNKNOWN - unable to read fan sensor ${SENSOR_INDEX}"
   exit "$STATE_UNKNOWN"
fi

STATE_TEXT="OK"
EXIT_CODE="$STATE_OK"

if [[ "$STATUS" != "Normal" ]]; then
   STATE_TEXT="CRITICAL"
   EXIT_CODE="$STATE_CRITICAL"
elif [[ -n "$CRIT_LVL" && "$RPM" -lt "$CRIT_LVL" ]]; then
   STATE_TEXT="CRITICAL"
   EXIT_CODE="$STATE_CRITICAL"
elif [[ -n "$WARN_LVL" && "$RPM" -lt "$WARN_LVL" ]]; then
   STATE_TEXT="WARNING"
   EXIT_CODE="$STATE_WARNING"
fi

if ! is_int "$MAX_RPM"; then
   MAX_RPM=""
fi

echo "${STATE_TEXT} - fan ${SENSOR_INDEX} (${DESC}) rpm=${RPM} status=${STATUS} | fan_rpm=${RPM};${WARN_LVL};${CRIT_LVL};0;${MAX_RPM}"
exit "$EXIT_CODE"
